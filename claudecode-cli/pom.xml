<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.iskeru</groupId>
		<artifactId>claudecode-p-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>claudecode-cli</artifactId>
	<name>Claude Code CLI core</name>
	<description>Spring-free Claude Code CLI transport, response envelope and record/replay layer</description>

	<dependencies>
		<!-- Parsing the CLI's JSON result envelope. The only dependency, by design. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  The Spring-free claim is the reason this module exists, so it is enforced
			  rather than documented: any Spring artifact arriving on the compile or test
			  classpath, directly or transitively, fails the build.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>ban-spring</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>org.springframework:*</exclude>
										<exclude>org.springframework.ai:*</exclude>
										<exclude>org.springframework.boot:*</exclude>
									</excludes>
									<message>claudecode-cli is the Spring-free core: it depends on Jackson and nothing else. Anything needing Spring AI or Spring Boot belongs in an adapter module.</message>
								</bannedDependencies>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
			  `RecordingFakeCli` is a fake of this module's own `ClaudeCodeCli`, and both
			  adapters' tests drive the model through it. One module's test sources are not
			  visible to another, so they are published as a test-jar.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<id>test-jar</id>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
